# virtual environment
.venv/
venv/

# data — never commit raw or processed data
data/
*.csv

# secrets
.env
*.env.local

# experiment tracking / model artifacts
mlruns/
mlartifacts/
*.pkl
*.joblib
# ...except the small (<1MB) trained artifacts Render/Streamlit Cloud need at deploy time — these
# are learned model parameters, not the Kaggle dataset itself, so committing them doesn't run into
# Kaggle's data-redistribution restriction the way committing data/ would.
!models/*.joblib

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# notebooks
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editor and tool state live in ~/.gitignore_global, not here — they're a property of
# my machine, not of this project, and every contributor would need a different set.

# personal planning docs, not part of the shipped project
*.pdf
Project 1 - AUTOPILOT - Credit Risk & IFRS 9 Engine.md

